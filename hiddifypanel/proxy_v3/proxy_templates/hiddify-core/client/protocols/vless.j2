{# VLESS without encryption over plain HTTP sends everything in clear: never offered #}
{{ skip("VLESS without encryption over plain HTTP") if ctx.proxy.tls_layer == "http" and not (ctx.proxy.server_core == "xray" and ctx.hconfig.vless_encryption) }}
{# raw VLESS on a REALITY domain ends at the reality termination, which can not use encryption #}
{%set reality_terminated = ctx.proxy.transport == "tcp" and ctx.proxy.domain.is_reality() %}
{%set encryption = 'none' if reality_terminated else (ctx.hconfig.vless_encryption or 'none') %}
{# VLESS encryption field: only sent when a cipher is actually configured. A core that does not know
   the key rejects the whole config even when its value is none, which used to make adding a profile
   fail outright with json: unknown field "encryption".

   NOTE: the version gate below is a heuristic, not a capability check - the app version says nothing
   about the core it ships (upstream ships app 5.0.0 with a core that has VLESS encryption, while a
   fork can ship app 5.0.3 with an older core that does not). No version threshold can separate the
   two, so a client below the gate is skipped while a client above it may still receive a key its
   core cannot parse. Enabling hconfig.vless_encryption therefore only works when every client runs
   a core that implements it; the robust fix is for the client to advertise its core version (in the
   User-Agent) and to gate on that instead of the app version. #}
{%set encryption_supported = ctx.platform.is_hiddify and ctx.platform.hiddify.version >= "5.0.0" %}
{# sing-box (SFA, SFI, ...) and Hiddify <5 have no VLESS encryption: omit the field; skip if the server requires it #}
{{ skip("VLESS encryption needs Hiddify 5+") if ctx.proxy.server_core == "xray" and encryption != "none" and not encryption_supported }}

"type": "vless",
"server": "{{ proxy.server }}",
"server_port": {{ ctx.proxy.port }},
"uuid": "{{ ctx.user.uuid }}",
{% if ctx.proxy.server_core == "xray" %}
{% if encryption_supported and encryption != 'none' %}
"encryption": "{{ encryption }}",
{% endif %}
{# Vision is TCP+REALITY only (the REALITY terminator), as in the sublink/xray templates (#5640) #}
{% if ctx.hconfig.vless_flow and reality_terminated %}
"flow": "{{ ctx.hconfig.vless_flow }}",
{% endif %}
{% endif %}
